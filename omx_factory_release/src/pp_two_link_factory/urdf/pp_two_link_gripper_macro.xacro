<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="pp_dark"><color rgba="0.18 0.20 0.23 1.0"/></material>
  <material name="pp_gray"><color rgba="0.62 0.65 0.68 1.0"/></material>
  <material name="pp_blue"><color rgba="0.10 0.34 0.74 1.0"/></material>
  <material name="pp_orange"><color rgba="0.95 0.42 0.08 1.0"/></material>
  <material name="pp_gripper"><color rgba="0.10 0.12 0.14 1.0"/></material>
  <material name="pp_finger"><color rgba="0.72 0.75 0.78 1.0"/></material>

  <!--
    Compact PP manipulator for the existing factory tables.
    PPV18 plant-only inertia test: all MOVING rigid-body inertial parameters
    (upper_arm, forearm, ee_link) are scaled by 3.1 relative to the compact PPV8 plant.
    Geometry, joint limits, damping and the two controlled DOFs are unchanged.
    Gravity remains disabled.  The model-free tracking controller does not use
    these mass/inertia values.
    Visual/collision geometry and the two controlled DOFs remain unchanged.
    Controlled DOFs remain exactly two: joint1 and joint2.
    Geometry only was reduced to avoid overlap between opposing stations.
      L1 = 0.45 m
      L2 = 0.38 m
      base radius = 0.12 m
      shoulder support = 0.22 m
    The fixed gripper is visual-only and adds no controlled DOF.
  -->
  <xacro:macro name="pp_two_link_gripper" params="prefix">
    <link name="world"/>
    <joint name="${prefix}world_fixed" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="world"/>
      <child link="${prefix}base_link"/>
    </joint>

    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry><cylinder radius="0.12" length="0.12"/></geometry>
        <material name="pp_dark"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.116" rpy="0 0 0"/>
        <geometry><cylinder radius="0.095" length="0.012"/></geometry>
        <material name="pp_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry><cylinder radius="0.12" length="0.12"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.0096" ixy="0.0" ixz="0.0" iyy="0.0096" iyz="0.0" izz="0.0144"/>
      </inertial>
    </link>

    <joint name="${prefix}base_to_shoulder_support" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}shoulder_support"/>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}shoulder_support">
      <visual>
        <origin xyz="0 0 0.11" rpy="0 0 0"/>
        <geometry><cylinder radius="0.070" length="0.22"/></geometry>
        <material name="pp_gray"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.213" rpy="0 0 0"/>
        <geometry><cylinder radius="0.085" length="0.026"/></geometry>
        <material name="pp_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.11" rpy="0 0 0"/>
        <geometry><cylinder radius="0.070" length="0.22"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.11" rpy="0 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.0036" ixy="0.0" ixz="0.0" iyy="0.0036" iyz="0.0" izz="0.0020"/>
      </inertial>
    </link>

    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}shoulder_support"/>
      <child link="${prefix}upper_arm"/>
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159" upper="3.14159" effort="15.0" velocity="8.0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>

    <link name="${prefix}upper_arm">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.085" length="0.14"/></geometry>
        <material name="pp_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.085" length="0.14"/></geometry>
      </collision>
      <visual>
        <origin xyz="0.225 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.038" length="0.45"/></geometry>
        <material name="pp_blue"/>
      </visual>
      <collision>
        <origin xyz="0.225 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.038" length="0.45"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.225 0 0" rpy="0 0 0"/>
        <mass value="6.2"/>
        <inertia ixx="0.031" ixy="0.0" ixz="0.0" iyy="0.403" iyz="0.0" izz="0.403"/>
      </inertial>
    </link>

    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}upper_arm"/>
      <child link="${prefix}forearm"/>
      <origin xyz="0.45 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="8.0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>

    <link name="${prefix}forearm">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.075" length="0.13"/></geometry>
        <material name="pp_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.075" length="0.13"/></geometry>
      </collision>
      <visual>
        <origin xyz="0.19 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.034" length="0.38"/></geometry>
        <material name="pp_orange"/>
      </visual>
      <collision>
        <origin xyz="0.19 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.034" length="0.38"/></geometry>
      </collision>
      <visual>
        <origin xyz="0.38 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.055" length="0.10"/></geometry>
        <material name="pp_gray"/>
      </visual>
      <collision>
        <origin xyz="0.38 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.055" length="0.10"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.19 0 0" rpy="0 0 0"/>
        <mass value="3.72"/>
        <inertia ixx="0.0186" ixy="0.0" ixz="0.0" iyy="0.155" iyz="0.0" izz="0.155"/>
      </inertial>
    </link>

    <joint name="${prefix}forearm_to_ee" type="fixed">
      <parent link="${prefix}forearm"/>
      <child link="${prefix}ee_link"/>
      <origin xyz="0.38 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}ee_link">
      <!-- Short wrist connector -->
      <visual>
        <origin xyz="0.025 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.026" length="0.05"/></geometry>
        <material name="pp_dark"/>
      </visual>
      <collision>
        <origin xyz="0.025 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.026" length="0.05"/></geometry>
      </collision>

      <!-- Compact fixed two-finger gripper: visual-only, no extra DOF. -->
      <visual name="gripper_adapter">
        <origin xyz="0.055 0 0" rpy="0 0 0"/>
        <geometry><box size="0.030 0.075 0.060"/></geometry>
        <material name="pp_gripper"/>
      </visual>
      <visual name="gripper_palm">
        <origin xyz="0.082 0 0" rpy="0 0 0"/>
        <geometry><box size="0.040 0.105 0.070"/></geometry>
        <material name="pp_gripper"/>
      </visual>
      <visual name="gripper_left_finger">
        <origin xyz="0.125 0.040 0" rpy="0 0 0"/>
        <geometry><box size="0.070 0.018 0.030"/></geometry>
        <material name="pp_finger"/>
      </visual>
      <visual name="gripper_right_finger">
        <origin xyz="0.125 -0.040 0" rpy="0 0 0"/>
        <geometry><box size="0.070 0.018 0.030"/></geometry>
        <material name="pp_finger"/>
      </visual>
      <visual name="gripper_left_tip">
        <origin xyz="0.160 0.034 -0.014" rpy="0 0 0"/>
        <geometry><box size="0.024 0.030 0.045"/></geometry>
        <material name="pp_gripper"/>
      </visual>
      <visual name="gripper_right_tip">
        <origin xyz="0.160 -0.034 -0.014" rpy="0 0 0"/>
        <geometry><box size="0.024 0.030 0.045"/></geometry>
        <material name="pp_gripper"/>
      </visual>

      <inertial>
        <origin xyz="0.04 0 0" rpy="0 0 0"/>
        <mass value="0.155"/>
        <inertia ixx="0.000248" ixy="0.0" ixz="0.0" iyy="0.000248" iyz="0.0" izz="0.000248"/>
      </inertial>
    </link>

    <gazebo reference="${prefix}base_link"><material>Gazebo/DarkGrey</material><gravity>false</gravity></gazebo>
    <gazebo reference="${prefix}shoulder_support"><material>Gazebo/Grey</material><gravity>false</gravity></gazebo>
    <gazebo reference="${prefix}upper_arm"><material>Gazebo/Blue</material><gravity>false</gravity></gazebo>
    <gazebo reference="${prefix}forearm"><material>Gazebo/Orange</material><gravity>false</gravity></gazebo>
    <gazebo reference="${prefix}ee_link"><material>Gazebo/DarkGrey</material><gravity>false</gravity></gazebo>
  </xacro:macro>
</robot>
